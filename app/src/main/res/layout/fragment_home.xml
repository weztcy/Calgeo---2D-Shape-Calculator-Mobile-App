<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    tools:context=".ui.home.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/home_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/home_padding_bottom">

            <!-- ================================================= -->
            <!-- HERO CARD -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/home_hero_margin_horizontal"
                android:layout_marginTop="@dimen/home_hero_margin_top"
                android:layout_marginEnd="@dimen/home_hero_margin_horizontal"
                app:cardBackgroundColor="@color/home_hero_background"
                app:cardCornerRadius="@dimen/home_hero_corner_radius"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/home_hero_min_height"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/home_hero_padding_horizontal"
                    android:paddingTop="@dimen/home_hero_padding_vertical"
                    android:paddingEnd="@dimen/home_hero_padding_horizontal"
                    android:paddingBottom="@dimen/home_hero_padding_vertical">

                    <!-- Hero Badge -->
                    <TextView
                        android:id="@+id/text_hero_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/home_hero_badge_height"
                        android:gravity="center_vertical"
                        android:letterSpacing="0.10"
                        android:text="@string/home_badge"
                        android:textColor="@color/home_hero_accent"
                        android:textSize="@dimen/home_eyebrow_text_size"
                        android:textStyle="bold" />

                    <!-- Hero Title -->
                    <TextView
                        android:id="@+id/text_hero_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:maxWidth="@dimen/home_hero_title_max_width"
                        android:text="@string/home_hero_title"
                        android:textColor="@color/home_hero_title"
                        android:textSize="@dimen/home_hero_title_size"
                        android:textStyle="bold"
                        android:lineSpacingExtra="2dp" />

                    <!-- Hero Subtitle -->
                    <TextView
                        android:id="@+id/text_hero_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:maxLines="3"
                        android:text="@string/home_hero_subtitle"
                        android:textColor="@color/home_hero_subtitle"
                        android:textSize="@dimen/home_hero_subtitle_size"
                        android:lineSpacingExtra="3dp" />

                    <!-- ================================================= -->
                    <!-- FEATURE ROW -->
                    <!-- ================================================= -->

                    <LinearLayout
                        android:id="@+id/feature_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/home_hero_feature_margin_top"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <!-- 8 Shapes -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/feature_background"
                            app:cardCornerRadius="@dimen/feature_item_corner_radius"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingStart="@dimen/spacing_xs"
                                android:paddingTop="@dimen/feature_item_padding_vertical"
                                android:paddingEnd="@dimen/spacing_xs"
                                android:paddingBottom="@dimen/feature_item_padding_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="8"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_subtitle"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_xs"
                                    android:gravity="center"
                                    android:maxLines="2"
                                    android:text="@string/home_feature_shapes"
                                    android:textColor="@color/feature_text"
                                    android:textSize="@dimen/feature_text_size" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Area & Perimeter -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/feature_background"
                            app:cardCornerRadius="@dimen/feature_item_corner_radius"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingStart="@dimen/spacing_xs"
                                android:paddingTop="@dimen/feature_item_padding_vertical"
                                android:paddingEnd="@dimen/spacing_xs"
                                android:paddingBottom="@dimen/feature_item_padding_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="✨"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_subtitle"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_xs"
                                    android:gravity="center"
                                    android:maxLines="2"
                                    android:text="@string/home_feature_calculations"
                                    android:textColor="@color/feature_text"
                                    android:textSize="@dimen/feature_text_size" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Offline -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/feature_background"
                            app:cardCornerRadius="@dimen/feature_item_corner_radius"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingStart="@dimen/spacing_xs"
                                android:paddingTop="@dimen/feature_item_padding_vertical"
                                android:paddingEnd="@dimen/spacing_xs"
                                android:paddingBottom="@dimen/feature_item_padding_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="✓"
                                    android:textColor="@color/home_hero_accent"
                                    android:textSize="@dimen/text_size_subtitle"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_xs"
                                    android:gravity="center"
                                    android:maxLines="2"
                                    android:text="@string/home_feature_offline"
                                    android:textColor="@color/feature_text"
                                    android:textSize="@dimen/feature_text_size" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- SHAPE SECTION -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/shape_section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/home_section_header_margin_horizontal"
                android:layout_marginTop="@dimen/home_section_margin_top"
                android:layout_marginEnd="@dimen/home_section_header_margin_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_shape_section_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/home_section_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/home_section_title_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_shape_section_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:gravity="center"
                    android:text="@string/home_section_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/home_section_subtitle_size" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SHAPE GRID -->
            <!-- ================================================= -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_shapes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_grid_margin_top"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/home_grid_padding_horizontal"
                android:paddingEnd="@dimen/home_grid_padding_horizontal"
                android:paddingBottom="@dimen/home_grid_padding_bottom"
                tools:itemCount="8"
                tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                tools:listitem="@layout/item_shape"
                tools:spanCount="2" />


            <!-- ================================================= -->
            <!-- ABOUT BUTTON -->
            <!-- ================================================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_about"
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_about_button_height"
                android:layout_marginStart="@dimen/home_padding_horizontal"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginEnd="@dimen/home_padding_horizontal"
                android:minHeight="0dp"
                android:text="@string/home_about"
                android:textAllCaps="false"
                android:textColor="@color/home_about_button_text"
                android:textSize="@dimen/text_size_body_small"
                android:textStyle="bold"
                app:backgroundTint="@color/home_about_button_background"
                app:cornerRadius="@dimen/home_about_button_corner_radius"
                app:strokeColor="@color/home_about_button_border"
                app:strokeWidth="1dp" />

            <!-- Bottom spacing -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_bottom_space" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>