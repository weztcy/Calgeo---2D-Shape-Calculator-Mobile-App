<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context=".ui.calculator.CalculatorFragment">

    <!-- ========================================================= -->
    <!-- TOOLBAR -->
    <!-- ========================================================= -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/toolbar_height"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:titleTextColor="?attr/colorOnSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ========================================================= -->
    <!-- SCROLL CONTENT -->
    <!-- ========================================================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingBottom="@dimen/spacing_xxl">


            <!-- ================================================= -->
            <!-- SHAPE ICON -->
            <!-- ================================================= -->

            <ImageView
                android:id="@+id/image_shape"
                android:layout_width="@dimen/shape_icon_large_size"
                android:layout_height="@dimen/shape_icon_large_size"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/shape_icon"
                android:scaleType="fitCenter"
                tools:src="@drawable/ic_circle" />


            <!-- ================================================= -->
            <!-- SHAPE DESCRIPTION -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/text_shape_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_body_small"
                tools:text="Calculate the area and circumference of a circle." />


            <!-- ================================================= -->
            <!-- INPUT SECTION -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/text_measurement_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/enter_measurements"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_size_subtitle"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_measurement_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/measurement_description"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_body_small" />


            <!-- ================================================= -->
            <!-- DYNAMIC INPUT -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/dynamic_input_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="vertical" />


            <!-- ================================================= -->
            <!-- ACTION BUTTONS -->
            <!-- Reset : Calculate = 1 : 2 -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/action_button_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- Reset -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_reset"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:text="@string/reset"
                    android:textAllCaps="false"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/button_corner_radius" />

                <!-- Calculate -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_calculate"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="2"
                    android:text="@string/calculate"
                    android:textAllCaps="false"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="@dimen/button_corner_radius" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- RESULT CARD -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/result_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/result_card_margin_top"
                android:visibility="gone"
                app:cardBackgroundColor="@color/result_card_background"
                app:cardCornerRadius="@dimen/result_card_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/result_card_border"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/result_card_padding">

                    <!-- Result Header -->
                    <TextView
                        android:id="@+id/text_result_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/calculation_result"
                        android:textColor="@color/result_card_title"
                        android:textSize="@dimen/text_size_subtitle"
                        android:textStyle="bold" />

                    <!-- Area Label -->
                    <TextView
                        android:id="@+id/text_area_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="@string/area"
                        android:textColor="@color/result_card_text"
                        android:textSize="@dimen/text_size_body_small" />

                    <!-- Area Result -->
                    <TextView
                        android:id="@+id/text_area_result"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/result_placeholder"
                        android:textColor="@color/result_card_value"
                        android:textSize="@dimen/text_size_result"
                        android:textStyle="bold"
                        tools:text="78.54 square units" />

                    <!-- Divider -->
                    <View
                        android:id="@+id/divider_result"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:layout_marginBottom="@dimen/spacing_lg"
                        android:background="@color/result_card_border" />

                    <!-- Perimeter / Circumference -->
                    <TextView
                        android:id="@+id/text_perimeter_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/perimeter"
                        android:textColor="@color/result_card_text"
                        android:textSize="@dimen/text_size_body_small" />

                    <!-- Perimeter Result -->
                    <TextView
                        android:id="@+id/text_perimeter_result"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/result_placeholder"
                        android:textColor="@color/result_card_value"
                        android:textSize="@dimen/text_size_result"
                        android:textStyle="bold"
                        tools:text="31.42 units" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>